<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="85dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:foreground="?selectableItemBackground"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_gradient_bg"
        android:padding="10dp">

        <!-- Accent Bar -->
        <View
            android:id="@+id/accentBar"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@drawable/accent_gradient"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Surah Number Circle -->
        <TextView
            android:id="@+id/surahNumber"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/circle_number_bg"
            android:gravity="center"
            android:text="01"
            android:textColor="@color/White"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:elevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/accentBar"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Surah Name & Info Container -->
        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:background="@color/transparent"
            app:layout_constraintBottom_toBottomOf="@+id/surahNumber"
            app:layout_constraintEnd_toStartOf="@+id/actionContainer"
            app:layout_constraintStart_toEndOf="@+id/surahNumber"
            app:layout_constraintTop_toTopOf="@+id/surahNumber">

            <TextView
                android:id="@+id/surahName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Al-Fatihah"
                android:textColor="@color/TextPrimary"
                android:textSize="18sp"
                android:background="@color/transparent"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/surahInformation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="MECCAN • 7 VERSES"
                android:textColor="@color/TextSecondary"
                android:textSize="12sp"
                android:background="@color/transparent"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Action Buttons Container -->
        <LinearLayout
            android:id="@+id/actionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/transparent"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/surahNameArabic"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Download Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/downloadIconContainer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/SurfaceBackground">

                <ImageButton
                    android:id="@+id/download"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/download"
                    android:tint="@color/Green"
                    android:scaleType="fitCenter"
                    android:contentDescription="Download Surah" />

            </androidx.cardview.widget.CardView>

            <!-- Read Icon -->
            <androidx.cardview.widget.CardView
                android:id="@+id/readIconContainer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/SurfaceBackground">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/surahRead"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_read"
                    android:tint="@color/Green" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Arabic Name -->
        <TextView
            android:id="@+id/surahNameArabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/allah_01"
            android:text="الفاتحة"
            android:textColor="@color/Green"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>